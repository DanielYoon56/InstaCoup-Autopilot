# ==============================================================================
# Instagram Affiliate Autopilot v1.0 — Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Content Generation (Gemini API)
# ------------------------------------------------------------------------------
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Host Application URL
# ------------------------------------------------------------------------------
# URL where this applet is hosted.
# Note: AI Studio dev preview domains (ais-dev-*.run.app) are ephemeral.
# Production webhooks require a permanent domain with persistent SLA.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 3. Meta Instagram Messaging Private Replies & Official Webhook
# ------------------------------------------------------------------------------
# Authentication Mode: Facebook Login / Facebook Page Access Token mode is strictly required.
# (Instagram Login mode is currently unsupported for Instagram Messaging Private Replies).

# Facebook Page Access Token (Requires permissions: pages_messaging, instagram_manage_comments)
# Keep confidential. NEVER expose in client bundles, localStorage, or API responses.
INSTAGRAM_ACCESS_TOKEN=""

# Linked Instagram Professional / Business Account ID (e.g., 17841400000000000)
INSTAGRAM_ACCOUNT_ID=""

# Connected Facebook Page ID (e.g., 102938475600000)
# CRITICAL: Do NOT confuse Facebook Page ID with Instagram Account ID!
FACEBOOK_PAGE_ID=""

# Meta Developer App ID
META_APP_ID=""

# Meta Developer App Secret (Used for HMAC-SHA256 X-Hub-Signature-256 verification)
META_APP_SECRET=""

# Meta Webhook Handshake Verification Token (Custom secret string)
# Configured in Meta App Dashboard > Webhooks > Verify Token.
META_VERIFY_TOKEN=""

# Meta Graph API Version (Default: v26.0 as specified in current Meta documentation)
META_GRAPH_API_VERSION="v26.0"

# Master kill-switch for automated outgoing DM dispatch (Default: false)
# Keep false until server persistent storage, webhook subscription, and rules are fully validated.
META_DM_ENABLED="false"

# ------------------------------------------------------------------------------
# 4. DM Routing Rules (Media -> Product & FTC Link Mapping)
# ------------------------------------------------------------------------------
# Explicit JSON array mapping Instagram Media IDs to verified products & affiliate links.
# Fail-closed: Comments on unregistered Media IDs or links with 'sample' will NOT trigger DMs.
# Example JSON:
# [
#   {
#     "mediaId": "17928374829102938",
#     "productName": "스텐 올인원 에어프라이어 7L",
#     "affiliateUrl": "https://link.coupang.com/a/realAffiliateLink123",
#     "triggerKeywords": ["링크", "정보", "가격", "에프"]
#   }
# ]
DM_RULES_JSON="[]"

# ------------------------------------------------------------------------------
# 5. Persistent Storage Configuration
# ------------------------------------------------------------------------------
# File path for transactional SQLite store (handling dedup, 24h user cooldown, audit log).
# Default: ./data/autopilot.sqlite
# WARNING: Cloud Run container restarts wipe ephemeral local disks.
# For production live dispatch, mount a persistent volume (Cloud Storage FUSE or Cloud SQL).
SQLITE_DB_PATH="./data/autopilot.sqlite"

# ------------------------------------------------------------------------------
# 6. Server Admin Protection
# ------------------------------------------------------------------------------
# Optional secret for authenticating server maintenance & diagnostic endpoints in public preview.
SERVER_ADMIN_SECRET=""
